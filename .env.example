# PostgreSQL connection string (Neon or any Postgres-compatible provider).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Auth.js session secret — generate with `npx auth secret`.
AUTH_SECRET=""

# Gmail SMTP (App Password, not your regular account password) — used for
# transactional emails: GIP assignment, task assignment, task ready-for-review.
# Optional: if unset, the app logs a warning and skips sending instead of
# failing the underlying action (see lib/email/send.ts).
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Vercel Blob read/write token — required for avatar and task-attachment
# uploads to work at all (unlike GMAIL_*, this is NOT optional: upload
# actions fail loudly with a clear error if unset, rather than no-oping).
# Get one from the Vercel dashboard (Storage -> Blob) or `vercel env pull`.
BLOB_READ_WRITE_TOKEN=""

# Base URL used to build the login link in onboarding emails (e.g. when a
# manager account is created). Optional: falls back to the production URL
# with a console warning if unset, same tolerance as GMAIL_*.
NEXT_PUBLIC_APP_URL="https://tortay-platform.vercel.app"
