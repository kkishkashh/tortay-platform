// ============================================================
// Tortay Engineering — платформа мониторинга инженерных проектов
// Схема базы данных (Prisma)
// ============================================================
// Комментарии на русском объясняют "зачем", не "что" — сама
// структура (названия моделей/полей) на английском, как
// принято в индустрии, чтобы код был совместим со стандартными
// библиотеками, примерами и документацией Prisma/Next.js.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// БЛОК 1: Пользователи, роли, проекты, разделы, задачи
// ============================================================

// Системная роль — влияет на то, что человек видит в целом
// (руководитель видит дашборд по всем проектам сразу).
enum SystemRole {
  РУКОВОДИТЕЛЬ
  СОТРУДНИК
}

// Просто информационная метка — НЕ влияет на права доступа.
enum UserType {
  ШТАТНЫЙ
  АУТСОРСЕР
}

model User {
  id           String     @id @default(uuid())
  fullName     String
  email        String     @unique
  passwordHash String
  systemRole   SystemRole @default(СОТРУДНИК)
  userType     UserType
  phone        String?
  position     String?
  birthDate    DateTime?  @db.Date
  avatarUrl    String? // ссылка на файл в Vercel Blob (см. app/api/uploads/avatar)
  // Косметическое поле, НЕ используется для входа (вход остаётся по email,
  // см. auth.ts) — только для формы создания руководителя (см. план, D1).
  username     String?    @unique
  // Деактивированный пользователь не может войти (см. auth.ts::authorize) —
  // запись и вся её история остаются, в отличие от полного удаления.
  isActive     Boolean    @default(true)
  // Точечный доступ к финансово-кадровой зоне (Аутсорсеры, Договоры) для
  // бухгалтеров, которые не руководят Административным департаментом —
  // см. lib/projects/permissions.ts::canManageFinance. Отдельно от
  // systemRole/managerId: не даёт никаких других прав.
  financeAccess Boolean   @default(false)
  createdAt    DateTime   @default(now())

  // Код подтверждения для "регистрации" (первый вход/сброс пароля через
  // почту) — см. lib/auth/actions.ts::requestVerificationCodeAction. Не
  // отдельная таблица: одному пользователю в любой момент нужен максимум
  // один активный код, храним прямо на записи.
  verificationCode          String?
  verificationCodeExpiresAt DateTime?

  // "Домашний" департамент сотрудника (Employees-таб на странице департамента).
  // Отдельно от ProjectMember.projectRole — это постоянная орг. принадлежность,
  // а не роль в конкретном проекте.
  homeDepartmentId   String?
  homeDepartment     Department?  @relation("DepartmentEmployees", fields: [homeDepartmentId], references: [id])
  // Департаменты, которыми этот пользователь руководит — многие-ко-многим
  // в обе стороны: один человек может руководить несколькими департаментами,
  // и с 2026-07-31 у одного департамента может быть несколько руководителей
  // одновременно, все с одинаковыми правами (см. Department.managers).
  managedDepartments Department[] @relation("DepartmentManagers")

  // Иерархия "Лид" (PRD #3 Phase 3, только в департаментах с
  // Department.allowsLeadRole) — кому подчиняется этот сотрудник, помимо
  // общего руководителя департамента. "Быть Лидом" НЕ отдельный флаг —
  // это чисто производный статус: человек — Лид ровно тогда, когда у
  // кого-то reportsToId указывает на него (см. reports ниже), тот же
  // принцип, что и у Department.managerId. Специально ограничено 2
  // уровнями (Лид сам не может кому-то подчиняться, см.
  // lib/leads/actions.ts) — глубже не усложняем.
  reportsToId String?
  reportsTo   User?   @relation("UserReportsTo", fields: [reportsToId], references: [id], onDelete: SetNull)
  reports     User[]  @relation("UserReportsTo")

  // Во всех проектах, где этот человек участвует (в разных ролях)
  projectMemberships ProjectMember[]
  documentsUploaded  Document[]
  comments           Comment[]
  activityLogEntries ActivityLog[]

  notifications          Notification[] @relation("NotificationRecipient")
  notificationsTriggered Notification[] @relation("NotificationActor")

  // Контактное лицо по департаменту на конкретном проекте (см. Section.contactManagerId) —
  // отображение/маршрутизация уведомлений, НЕ источник прав (canManageProjectTasks и т.п.
  // по-прежнему смотрят только на Department.managerId).
  sectionsAsContactManager Section[]      @relation("SectionContactManager")
  // Кто поставил задачу — заполняется автоматически при создании, никогда не редактируется вручную.
  tasksAssignedByMe        Task[]         @relation("TaskAssignedBy")
  personalTasks            PersonalTask[]
  outsourcersAddedToProjects ProjectOutsourcer[]
  auditLogEntriesAsActor   AuditLog[]
  sectionDeadlineChanges   SectionDeadlineChange[]
  sectionPulses            SectionPulse[]

  @@map("users")
}

// Роль конкретно ВНУТРИ конкретного проекта.
// Один и тот же человек может быть ГИП в одном проекте
// и инженером в другом — поэтому роль хранится здесь,
// а не в самой таблице users.
enum ProjectRole {
  ГИП
  МЕНЕДЖЕР
  ИНЖЕНЕР
  ПОМОЩНИК_ГИП
  ВЕДУЩИЙ_СПЕЦИАЛИСТ
}

model ProjectMember {
  id          String      @id @default(uuid())
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id])
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  projectRole ProjectRole
  assignedAt  DateTime    @default(now())

  tasksAssigned     Task[]
  contractsCreated  Contract[]
  digitalSignatures DigitalSignature[]

  // Один человек не может быть добавлен в один проект дважды
  @@unique([projectId, userId])
  @@map("project_members")
}

enum ProjectStatus {
  В_РАБОТЕ
  ЗАВЕРШЁН_ПО_РАЗДЕЛАМ
  ЗАВЕРШЁН_ПОЛНОСТЬЮ
}

model Project {
  id          String        @id @default(uuid())
  name        String
  status      ProjectStatus @default(В_РАБОТЕ)
  // Архивирование (Task 1.2, PRD #3 Phase 2) — обратимая альтернатива
  // жёсткому удалению: архивный проект скрыт из основного списка
  // (см. lib/projects/queries.ts), но данные остаются нетронутыми.
  // Жёсткое удаление (deleteProjectAction) теперь отдельное, admin-only
  // действие, не связанное с этим полем.
  isArchived  Boolean       @default(false)
  createdAt   DateTime      @default(now())
  // Фиксируется в момент перехода status → ЗАВЕРШЁН_ПОЛНОСТЬЮ.
  // Нужна отдельно от createdAt для статистики "завершено в этом году" —
  // проект может быть начат в одном году, а закрыт в другом.
  completedAt DateTime?

  // Поля мастера создания проекта (см. план, Phase 13) — все необязательны,
  // у проектов, созданных до этой фазы, просто остаются пустыми.
  client      String?
  location    String?
  startDate   DateTime?
  endDate     DateTime?
  description String?

  members     ProjectMember[]
  sections    Section[]
  contracts   Contract[]
  comments    Comment[]
  activityLog ActivityLog[]
  outsourcers ProjectOutsourcer[]

  @@map("projects")
}

enum SectionStatus {
  В_РАБОТЕ
  ВЫПОЛНЕНО
}

model Section {
  id                String        @id @default(uuid())
  projectId         String
  project           Project       @relation(fields: [projectId], references: [id])
  name              String
  status            SectionStatus @default(В_РАБОТЕ)
  startDate         DateTime? // для диаграммы Ганта
  deadline          DateTime?
  // Базовый (контрактный) срок — Гант (Phase 3 архитектурного дашборда,
  // 2026-07-30, из прототипа ProjecTeam: тонкая линия базового срока vs
  // толстая линия текущего). Замораживается ПЕРВЫМ когда-либо заданным
  // значением startDate/deadline (см. updateSectionDatesAction) и больше
  // никогда не меняется — это отдельно от startDate/deadline, которые
  // продолжают меняться при продлениях. Независимы друг от друга: можно
  // сначала задать старт, потом дедлайн, каждое замораживается в свой
  // момент.
  baselineStartDate DateTime?
  baselineDeadline  DateTime?
  orderIndex        Int           @default(0) // для сортировки разделов внутри проекта

  // Департамент, ответственный за раздел — источник истины для базового
  // стека задач, цвета/иконки и области видимости руководителя департамента.
  // Nullable: у разделов, созданных до перехода на департаменты (см. миграцию
  // prisma/scripts/migrate-departments.ts), однозначного соответствия может
  // не быть — тогда остаётся NULL, а не угадывается.
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  // Контакт по этому департаменту НА ЭТОМ проекте — по умолчанию совпадает
  // с реальным руководителем департамента, но может быть переопределён при
  // создании проекта (мастер, шаг 3). Это только контакт для отображения/
  // уведомлений — Department.managerId (структура компании) не трогает.
  contactManagerId String?
  contactManager   User?   @relation("SectionContactManager", fields: [contactManagerId], references: [id])

  tasks             Task[]
  documents         Document[]
  comments          Comment[]
  paymentsTriggered Payment[]
  deadlineChanges   SectionDeadlineChange[]
  pulses            SectionPulse[]

  @@map("sections")
}

// Причина сдвига срока — из прототипа ProjecTeam департамента Архитектуры
// (2026-07-30): деление на внешние (срок "съел" не проектировщик — можно
// предъявить Заказчику при обсуждении переноса) и внутренние (в т.ч.
// "творческая проработка" — поиск решения, легальная причина, а не
// простой). Общий для всей компании список — не только для Архитектуры,
// но остальные разделы им просто не обязаны пользоваться (reasonCategory
// nullable).
enum ShiftReasonCategory {
  ПРАВКИ_ЗАКАЗЧИКА          // внешняя
  ИЗМЕНЕНИЕ_ПРОГРАММЫ       // внешняя — изменение функциональной программы
  НЕТ_ИСХОДНЫХ_ДАННЫХ       // внешняя — нет ТУ / ГПЗУ / исходных данных
  ЗАМЕЧАНИЯ_ЭКСПЕРТИЗЫ      // внешняя
  СОГЛАСОВАНИЕ_ГОСОРГАНОВ   // внешняя
  СМЕЖНИКИ_СУБПОДРЯД        // внешняя
  ТВОРЧЕСКАЯ_ПРОРАБОТКА     // внутренняя — поиск решения, это работа, не простой
  ВНУТРЕННИЕ_ПРИЧИНЫ        // внутренняя — прочее на стороне команды
}

// История изменений срока раздела (по просьбе Камилы: "был такой-то срок,
// не успели, продлили — нужна причина продления"). Пишем запись при КАЖДОМ
// изменении deadline, но reasonCategory обязателен только когда это реально
// продление (новый срок позже старого) — см. lib/projects/actions.ts::
// updateSectionDatesAction. comment — свободный текст поверх категории
// ("что именно произошло"), всегда необязателен.
model SectionDeadlineChange {
  id               String                @id @default(uuid())
  sectionId        String
  section          Section               @relation(fields: [sectionId], references: [id])
  previousDeadline DateTime?
  newDeadline      DateTime?
  reasonCategory   ShiftReasonCategory?
  comment          String?
  changedByUserId  String
  changedByUser    User                  @relation(fields: [changedByUserId], references: [id])
  createdAt        DateTime              @default(now())

  @@index([sectionId])
  @@map("section_deadline_changes")
}

// "Пульс недели" (2026-07-30, департамент Архитектуры, см.
// Department.usesPulseTracking) — еженедельный сигнал состояния раздела
// вместо ежедневных отчётов. Один сигнал на раздел за ISO-неделю
// (@@unique) — повторная отметка на той же неделе просто обновляет
// запись, не плодит дубли. Отсутствие записи за неделю — НЕ нарушение
// (см. lib/pulse/queries.ts) — "нет сигнала" считается нейтральным
// состоянием, не тревожным.
enum PulseSignal {
  ЗЕЛЁНЫЙ  // в графике
  ЖЁЛТЫЙ   // есть трение
  КРАСНЫЙ  // нужна помощь
}

model SectionPulse {
  id        String      @id @default(uuid())
  sectionId String
  section   Section     @relation(fields: [sectionId], references: [id])
  // ISO-неделя вида "2026-W31" — считается на сервере (см. lib/pulse/week.ts),
  // не полагаемся на часовой пояс браузера.
  isoWeek   String
  signal    PulseSignal
  note      String?
  authorId  String
  author    User        @relation(fields: [authorId], references: [id])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([sectionId, isoWeek])
  @@index([sectionId])
  @@map("section_pulses")
}

enum TaskStatus {
  НОВАЯ
  В_РАБОТЕ
  НА_ПРОВЕРКЕ
  ВЫПОЛНЕНО
}

enum TaskPriority {
  НИЗКИЙ
  СРЕДНИЙ
  ВЫСОКИЙ
  СРОЧНЫЙ
}

model Task {
  id               String         @id @default(uuid())
  sectionId        String
  section          Section        @relation(fields: [sectionId], references: [id])
  title            String
  description      String?
  assigneeMemberId String?
  assigneeMember   ProjectMember? @relation(fields: [assigneeMemberId], references: [id])
  // Кто поставил задачу — заполняется автоматически (сессия создателя) при
  // создании через мастер проекта или вручную в разделе; у задач, созданных
  // до этой фазы, остаётся NULL (надёжного источника для бэкафилла нет).
  assignedByUserId String?
  assignedByUser   User?          @relation("TaskAssignedBy", fields: [assignedByUserId], references: [id])
  status           TaskStatus     @default(НОВАЯ)
  priority         TaskPriority   @default(СРЕДНИЙ)
  startDate        DateTime? // для диаграммы Ганта
  deadline         DateTime?
  createdAt        DateTime       @default(now())
  // Весовой прогресс раздела (Phase 2 архитектурного дашборда, 2026-07-30,
  // из прототипа ProjecTeam — "весовой прогресс ЭП/АР") — копируется из
  // DepartmentTaskTemplateItem.weight при создании задачи из пункта стека
  // (см. createProjectAction), у обычных/ручных задач остаётся 1 (равный
  // вес). Прогресс раздела считается на лету (см. lib/tasks/progress.ts),
  // нигде не хранится отдельно — заменяет ранее неиспользовавшееся
  // Section.completionPercent.
  weight           Int            @default(1)

  comments       Comment[]
  notifications  Notification[]
  documents      Document[]
  checklistItems TaskChecklistItem[]

  @@map("tasks")
}

// Личная задача — не привязана ни к проекту, ни к разделу, ни к
// департаменту: и сотрудник, и руководитель может завести себе напоминание
// прямо в "Мои задачи" (см. кнопку "+ Новая задача"). Владелец — единственный,
// кто её видит/меняет/удаляет, никакого согласования/проверки руководителем
// не требуется — это личный список дел, а не рабочая задача по проекту.
model PersonalTask {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  title       String
  description String?
  status      TaskStatus   @default(НОВАЯ)
  priority    TaskPriority @default(СРЕДНИЙ)
  deadline    DateTime?
  createdAt   DateTime     @default(now())

  @@map("personal_tasks")
}

// Список должностей для выпадающего списка при создании/редактировании
// сотрудника (см. lib/employees/positions.ts — раньше был захардкоженным
// TS-массивом COMMON_POSITIONS). User.position остаётся простой строкой,
// не внешним ключом сюда — эта таблица только питает подсказку в форме,
// не ограничивает её жёстко (можно было и раньше ввести что угодно через
// БД напрямую), поэтому переименование/удаление позиции здесь не трогает
// уже сохранённые значения у существующих сотрудников.
model Position {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  @@map("positions")
}

// Лёгкий чек-лист внутри задачи (см. план "Task checklist sub-items") —
// просто заголовок + галочка "сделано/не сделано", без своего исполнителя/
// срока/статуса/комментариев. Заполняется при создании задачи из подпунктов
// выбранного пункта базового стека (см. createProjectAction), либо остаётся
// пустым у задач без подпунктов.
model TaskChecklistItem {
  id         String   @id @default(uuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id])
  title      String
  isDone     Boolean  @default(false)
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())

  @@map("task_checklist_items")
}

// ============================================================
// БЛОК 1.6: Уведомления
// ============================================================
// Только два триггера пока (см. бриф): назначение задачи исполнителю и
// отправка задачи на проверку менеджеру/руководителю департамента. Тип —
// enum, а не свободный текст, чтобы интерфейс мог показывать разные
// иконки/маршруты по типу, не парся текст сообщения.
enum NotificationType {
  ЗАДАЧА_НАЗНАЧЕНА
  ЗАДАЧА_НА_ПРОВЕРКЕ
  МЕНЕДЖЕР_СОЗДАН
  // Забран из батча Phase 14 раньше времени — нужен уже здесь для
  // resetManagerPasswordAction; changePasswordAction (сброс пароля
  // руководителем для обычного сотрудника) переиспользует ту же функцию
  // на Phase 14, не заводя дублирующее значение enum.
  ПАРОЛЬ_СБРОШЕН
  // Phase 14 — расширение уведомлений/писем (см. план).
  СОТРУДНИК_СОЗДАН
  ДЕПАРТАМЕНТ_НАЗНАЧЕН
  УЧАСТНИК_ПРОЕКТА_ДОБАВЛЕН
  ГИП_НАЗНАЧЕН
  СРОК_ИЗМЕНЁН
  ЗАДАЧА_ВОЗВРАЩЕНА
  ЗАДАЧА_ОДОБРЕНА
  ЗАДАЧА_В_РАБОТЕ
  ДОЛЖНОСТЬ_ИЗМЕНЕНА
  // PRD #3 Phase 3 — иерархия "Лид".
  ЛИД_НАЗНАЧЕН
  ЛИД_СНЯТ
  // PRD #3 Phase 4 (Task 7.2) — оплата транша по договору проекта.
  ОПЛАТА_ПОЛУЧЕНА
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation("NotificationRecipient", fields: [userId], references: [id])
  actorId   String?
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id])
  type      NotificationType
  title     String
  body      String
  taskId    String?
  task      Task?            @relation(fields: [taskId], references: [id])
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

// ============================================================
// БЛОК 1.7: Аудит-лог (PRD #3, Epic 6.1/1.1/6.3) — привилегированные
// действия (смена системной роли/финансового доступа, переназначение
// руководителя департамента, вмешательство администратора/бухгалтера в
// чужую задачу). Только добавочная запись, из кода не редактируется и
// не удаляется. targetId — свободная строка, НЕ внешний ключ: цель
// (сотрудник, департамент, задача) может быть позже жёстко удалена
// (см. Task 1.2), история при этом не должна ломаться.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String
  targetType String
  targetId   String
  // true — это привилегированное вмешательство в чужую зону
  // ответственности (см. lib/audit/log.ts::isPrivilegedOverride), а не
  // обычное действие в рамках своих полномочий.
  isOverride Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([createdAt])
  @@map("audit_log")
}

// ============================================================
// БЛОК 1.5: Департаменты — организационная структура компании
// ============================================================
// Полностью редактируемая администратором сущность (см. бриф): ничего про
// департаменты не хардкодится в коде, только эти 8 строк заведены как
// стартовые сидовые данные (prisma/scripts/migrate-departments.ts).

model Department {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique // AR, KJ, VK, OV, EOM, SS, PB, SMR — короткий код для меток/бейджей
  color       String // hex, напр. "#7c3aed"
  icon        String // имя иконки lucide-react — резолвится через фиксированную карту в коде,
  // никогда не через eval/динамический импорт по произвольной строке
  description String?
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())

  // Многие-ко-многим (с 2026-07-31, по запросу Камилы): у департамента
  // может быть несколько руководителей одновременно, все с полным
  // паритетом прав — см. lib/departments/permissions.ts::isDepartmentManager.
  // Раньше было единственное скалярное поле managerId; переход сохранил
  // существующие назначения через миграцию с ручной вставкой данных
  // (см. миграцию add_multiple_department_managers).
  managers User[] @relation("DepartmentManagers")

  // Включает промежуточную роль "Лид" для этого департамента (PRD #3
  // Phase 3) — выключено по умолчанию у всех департаментов, руководитель
  // департамента не может назначать Лидов, пока администратор явно не
  // включит здесь (см. app/(dashboard)/departments/[id]/settings-tab.tsx).
  allowsLeadRole Boolean @default(false)

  // Включает "Пульс недели" (2026-07-30, по запросу департамента
  // Архитектуры через готовый прототип ProjecTeam) — еженедельный
  // сигнал-статус по разделам этого департамента вместо ежедневных
  // отчётов, см. lib/pulse/*. Выключено по умолчанию — опциональная
  // фича для департаментов, которые сами её попросили, не навязывается
  // остальным.
  usesPulseTracking Boolean @default(false)

  employees         User[]                       @relation("DepartmentEmployees")
  taskTemplateItems DepartmentTaskTemplateItem[]
  sections          Section[]

  @@map("departments")
}

// Базовый стек — стандартные задачи департамента; нестандартный — те же
// по структуре, но встречаются реже (спецработы, нетипичные случаи).
// Обе категории живут в одной таблице (одинаковая форма: подпункты,
// переупорядочивание, дублирование), отличаются только этим полем.
enum TaskStackCategory {
  БАЗОВЫЙ
  НЕСТАНДАРТНЫЙ
}

// Базовый/нестандартный стек задач — переиспользуемый шаблон, НЕ привязан
// ни к одному проекту. При создании проекта менеджер выбирает галочками,
// какие пункты стать реальными Task в конкретном разделе — сам шаблон при
// этом не меняется (см. бриф, раздел "Custom Tasks").
model DepartmentTaskTemplateItem {
  id           String            @id @default(uuid())
  departmentId String
  department   Department        @relation(fields: [departmentId], references: [id])
  title        String
  description  String?
  category     TaskStackCategory @default(БАЗОВЫЙ)
  orderIndex   Int               @default(0)
  createdAt    DateTime          @default(now())
  // Вес для весового прогресса раздела (см. Task.weight) — имеет смысл
  // только у пунктов верхнего уровня (parentItemId null), у подпунктов
  // не используется: подпункты становятся чек-листом ВНУТРИ одной задачи
  // (TaskChecklistItem), а не отдельными весовыми единицами.
  weight       Int               @default(1)

  // Подпункты пункта стека (напр. "АР Альбом" → его подразделы) — только
  // 2 уровня: у подпункта своих подпунктов не бывает (проверяется в коде,
  // см. createTaskStackSubItemAction). onDelete: Cascade — иначе Prisma по
  // умолчанию для опциональной само-связи сделал бы SetNull, "осиротив"
  // подпункты в отдельные пункты верхнего уровня вместо удаления вместе с
  // родителем.
  parentItemId String?
  parentItem   DepartmentTaskTemplateItem?  @relation("TemplateSubItems", fields: [parentItemId], references: [id], onDelete: Cascade)
  subItems     DepartmentTaskTemplateItem[] @relation("TemplateSubItems")

  @@map("department_task_template_items")
}

// ============================================================
// БЛОК 2: Документы, комментарии
// ============================================================

// sectionId/taskId — ровно одно из двух должно быть заполнено (та же
// схема, что и у Comment ниже: правило проверяется в коде backend, не
// в БД). sectionId сделан необязательным в той же миграции, где появился
// taskId — вложения к задачам это первый реальный потребитель Document,
// раздельные вложения к разделу пока нигде не используются в UI.
model Document {
  id         String   @id @default(uuid())
  sectionId  String?
  section    Section? @relation(fields: [sectionId], references: [id])
  taskId     String?
  task       Task?    @relation(fields: [taskId], references: [id])
  uploadedBy String
  uploader   User     @relation(fields: [uploadedBy], references: [id])
  fileName   String
  fileUrl    String // ссылка на файл во внешнем хранилище (не сам файл!)
  fileSize   Int?
  uploadedAt DateTime @default(now())

  @@map("documents")
}

// Комментарий может относиться к проекту, разделу ИЛИ задаче —
// ровно одно из трёх полей должно быть заполнено.
// Это правило проверяется в коде backend (см. бриф для Claude Code),
// база данных сама по себе это не гарантирует.
model Comment {
  id        String   @id @default(uuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
  sectionId String?
  section   Section? @relation(fields: [sectionId], references: [id])
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  text      String
  createdAt DateTime @default(now())

  @@map("comments")
}

// Лента "Последние события" на дашборде. Для MVP храним готовое
// человекочитаемое сообщение (не структурированный тип события +
// entity_id) — проще и достаточно, пока нет других потребителей этих
// данных кроме самой ленты. Если появится, например, фильтр по типу
// события — тогда стоит пересмотреть.
model ActivityLog {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  message   String
  createdAt DateTime @default(now())

  @@index([projectId])
  @@map("activity_log")
}

// Организация-подрядчик (аутсорсер) — юрлицо, не участник User: не
// логинится, не входит в ProjectMember. Это отдельно от
// User.userType = АУТСОРСЕР (конкретные люди-участники проекта из
// сторонних организаций) — см. обсуждение при добавлении этой модели:
// в брифе "аутсорсер" изначально означал человека, здесь — компанию.
// Статус договора не отдельный enum, а вычисляется из наличия
// contractNumber (пусто → "Нет договора"), как и "Задержан" у проектов.
model Outsourcer {
  id             String   @id @default(uuid())
  organization   String
  specialization String
  phone          String
  email          String
  directorName   String
  contractNumber String?  @unique
  createdAt      DateTime @default(now())

  // Поля ниже — для автогенерации договора подряда с физлицом-исполнителем
  // в Word (см. lib/outsourcers/contract-docx.ts). organization для такого
  // договора используется как ФИО исполнителя (person), а не название
  // компании — сознательно не заводим отдельное поле fullName, чтобы не
  // дублировать то, что уже вводится при создании карточки. Все поля
  // необязательны — они нужны только в момент реальной генерации договора,
  // не при первичном создании карточки аутсорсера.
  iin               String? // ИИН исполнителя
  address           String? // адрес исполнителя
  bankName          String?
  bankKbe           String? // КБе (код бенефициара)
  bankAccountNumber String? // ИИК
  bankBik           String?
  idCardNumber      String? // № удостоверения личности
  idCardIssuedAt    DateTime? @db.Date
  idCardIssuedBy    String? // кем выдано, напр. "МВД РК"

  contractDate   DateTime? @db.Date
  projectSubject String?   @db.Text // предмет договора / название и описание объекта
  durationDays   Int? // срок выполнения работ, календарных дней
  totalAmount    Decimal?  @db.Decimal(14, 2)

  // Разбивка оплаты на до 3 траншей (проценты должны суммарно давать 100 —
  // проверяется в updateOutsourcerContractDetailsAction, не на уровне БД).
  // Два готовых пресета в форме — 60/20/20 и 40/30/30 — но это просто
  // дефолтные значения полей, а не отдельная сущность: можно вводить любые
  // свои проценты. Триггер каждого транша в тексте договора определяется
  // динамически по позиции среди НЕнулевых траншей (первый — при подписании,
  // последний — по сдаче работ, средний(е) — по сдаче промежуточного этапа),
  // см. lib/outsourcers/contract-docx.ts.
  paymentPercent1 Int? @default(60)
  paymentPercent2 Int? @default(20)
  paymentPercent3 Int? @default(20)

  // Многоразовый список "функций" аутсорсера (в основном "Лицензия", но
  // расширяемо) — отдельно от specialization (домен: геодезия/архитектура/
  // ...), это то, ЧТО именно аутсорсер предоставляет компании. Растёт
  // через "+ добавить" на месте, как Position (см. lib/positions).
  functions OutsourcerFunction[]

  // Проекты, на которых работает этот аутсорсер — каждый со своим
  // отдельным договором/траншами (см. модель ProjectOutsourcer ниже), по
  // прямой просьбе Камилы: один и тот же аутсорсер может одновременно
  // работать на нескольких проектах разных департаментов, каждый раз на
  // разных условиях.
  projectEngagements ProjectOutsourcer[]

  @@map("outsourcers")
}

model OutsourcerFunction {
  id          String       @id @default(uuid())
  name        String       @unique
  createdAt   DateTime     @default(now())
  outsourcers Outsourcer[]

  @@map("outsourcer_functions")
}

// Один "выход" аутсорсера на конкретный проект — отдельный договор,
// отдельные транши, отдельный статус оплаты, даже если это тот же самый
// Outsourcer, что уже работает на других проектах. Реквизиты исполнителя
// (ИИН/адрес/банк/удостоверение) остаются на самом Outsourcer — это
// свойства человека/организации, не меняются от проекта к проекту.
model ProjectOutsourcer {
  id           String     @id @default(uuid())
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id])
  outsourcerId String
  outsourcer   Outsourcer @relation(fields: [outsourcerId], references: [id])
  // Кто из бухгалтеров/админов добавил этого аутсорсера в проект — чтобы
  // руководитель департамента видел, кто именно это сделал (см. запрос
  // Камилы: "видит что бухгалтер добавила аутсорсера в проект").
  addedByUserId String
  addedByUser   User     @relation(fields: [addedByUserId], references: [id])
  createdAt     DateTime @default(now())

  contractNumber String?   @unique
  contractDate   DateTime? @db.Date
  projectSubject String?   @db.Text
  durationDays   Int?
  totalAmount    Decimal?  @db.Decimal(14, 2)

  // Та же схема траншей, что у Outsourcer (см. выше) — плюс отметка
  // "оплачено" по каждому траншу, которой раньше не было: именно она
  // отвечает на вопрос Камилы "можно ли начинать работать над проектом" —
  // первый ненулевой транш = аванс, его оплата = сигнал для руководителя
  // департамента, что можно стартовать.
  paymentPercent1 Int? @default(60)
  paymentPercent2 Int? @default(20)
  paymentPercent3 Int? @default(20)
  tranche1Paid    Boolean @default(false)
  tranche2Paid    Boolean @default(false)
  tranche3Paid    Boolean @default(false)

  @@unique([projectId, outsourcerId])
  @@map("project_outsourcers")
}

// ============================================================
// БЛОК 3: Финансовый блок — договоры, реквизиты, платежи, ЭЦП
// ============================================================

// ОТМЕНЁН добавлен для страницы "Договоры" (там нет отдельного шага
// проверки ГИП, но нужен явный статус отмены) — остальные 5 значений
// из исходного брифа не трогаем, ЗАКРЫТ уже покрывает "завершён".
enum ContractStatus {
  ЧЕРНОВИК
  НА_ПРОВЕРКЕ_ГИП
  СОГЛАСОВАН
  ПОДПИСАН
  ЗАКРЫТ
  ОТМЕНЁН
}

// Статус АВР — отдельный трекер стадии, не связан с ClosingDocument
// (там хранятся реально сгенерированные документы с ЭЦП — другая задача).
enum AvrStage {
  НЕТ
  СТАДИЯ_1
  СТАДИЯ_2
  ФИНАЛЬНАЯ
}

model Contract {
  id                String         @id @default(uuid())
  projectId         String
  project           Project        @relation(fields: [projectId], references: [id])
  createdByMemberId String // менеджер, сформировавший договор
  createdByMember   ProjectMember  @relation(fields: [createdByMemberId], references: [id])
  number            String         @unique // человекочитаемый номер, напр. "ДОГ-2025-018"
  clientName        String // заказчик
  totalAmount       Decimal        @db.Decimal(14, 2)
  status            ContractStatus @default(ЧЕРНОВИК)
  avrStage          AvrStage       @default(НЕТ)
  createdAt         DateTime       @default(now())

  requisites        Requisites?
  payments          Payment[]
  digitalSignatures DigitalSignature[]
  closingDocuments  ClosingDocument[]

  @@map("contracts")
}

// Банковские реквизиты — понадобятся для интеграции с 1С/банк-клиентом
model Requisites {
  id            String   @id @default(uuid())
  contractId    String   @unique
  contract      Contract @relation(fields: [contractId], references: [id])
  bankName      String?
  accountNumber String? // ИИК / расчётный счёт
  bik           String? // БИК банка
  binIin        String? // БИН/ИИН контрагента

  @@map("requisites")
}

enum PaymentType {
  АВАНС
  ТРАНШ_2
  ТРАНШ_3
}

enum PaymentStatus {
  ОЖИДАЕТСЯ
  ОПЛАЧЕНО
}

model Payment {
  id                   String        @id @default(uuid())
  contractId           String
  contract             Contract      @relation(fields: [contractId], references: [id])
  paymentType          PaymentType
  amount               Decimal       @db.Decimal(14, 2)
  status               PaymentStatus @default(ОЖИДАЕТСЯ)
  dueDate              DateTime? // плановый срок платежа — задаётся вручную менеджером
  paidAt               DateTime? // менеджер фиксирует фактическую дату оплаты вручную
  triggeredBySectionId String? // какой раздел/этап открывает доступность транша
  triggeredBySection   Section?      @relation(fields: [triggeredBySectionId], references: [id])

  @@map("payments")
}

// ЭЦП — здесь хранится РЕЗУЛЬТАТ подписи от внешнего провайдера
// (напр. НУЦ РК), а не реализация самой криптографии.
model DigitalSignature {
  id               String        @id @default(uuid())
  contractId       String
  contract         Contract      @relation(fields: [contractId], references: [id])
  signedByMemberId String
  signedByMember   ProjectMember @relation(fields: [signedByMemberId], references: [id])
  signatureData    String // данные подписи/сертификата от внешнего провайдера ЭЦП
  signedAt         DateTime      @default(now())

  closingDocuments ClosingDocument[]

  @@map("digital_signatures")
}

enum ClosingDocumentType {
  АВР
}

model ClosingDocument {
  id                 String              @id @default(uuid())
  contractId         String
  contract           Contract            @relation(fields: [contractId], references: [id])
  documentType       ClosingDocumentType
  digitalSignatureId String?
  digitalSignature   DigitalSignature?   @relation(fields: [digitalSignatureId], references: [id])
  createdAt          DateTime            @default(now())

  @@map("closing_documents")
}
